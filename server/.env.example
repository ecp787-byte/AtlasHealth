# Copy to .env and fill in before switching any stub to a real integration.
# Nothing in server/ reads these yet except as documented in each lib file's
# header comment - they're listed here so it's obvious what to collect.

PORT=8787

# Twilio Verify (OTP) - see server/lib/otp.js
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# GoHighLevel (CRM) - see server/lib/ghl.js
GHL_API_KEY=
GHL_LOCATION_ID=

# Meta Conversions API - see server/lib/meta.js
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Lead Prosper (sells each verified lead into the exchange) - see
# server/lib/leadProsper.js. Values are per-campaign, from Lead Prosper's
# API spec doc for this campaign (Compass Health OTP), not account-wide.
LP_CAMPAIGN_ID=
LP_SUPPLIER_ID=
LP_KEY=

# TrustedForm Retain (permanently stores each lead's consent certificate,
# since this account's Auto-Retain toggle isn't usable) - see
# server/lib/trustedFormRetain.js. Generate under your ActiveProspect
# account's API key settings (Settings -> API, or similar).
TRUSTEDFORM_API_KEY=

# Lead Prosper lookup (finds which buyer purchased a lead, for the
# appointment-booking calendar invite) - see server/lib/leadProsperLookup.js.
# This is a DIFFERENT credential from LP_KEY above: an account-level Bearer
# token from Lead Prosper's dashboard (Settings / Integrations - look for
# "API" or "Personal Access Token"; ask Lead Prosper support if it isn't
# obvious), not the per-campaign posting key.
LP_API_TOKEN=

# Resend (sends the calendar-invite email when a lead books an appointment)
# - see server/lib/calendarInvite.js. Create an account at resend.com, then
# verify atlashealthcare.us as a sending domain (Domains -> Add Domain ->
# add the DNS records it gives you) before real invites can go to anyone
# other than your own Resend account email.
RESEND_API_KEY=
# Optional - defaults to appointments@atlashealthcare.us once the domain is
# verified in Resend. Format: "Display Name <address@domain>".
RESEND_FROM_EMAIL=
# Optional - IANA timezone the booking time slots (9:00 AM, 1:00 PM, etc.)
# are in. Defaults to America/New_York. Only matters for the calendar
# invite's actual UTC time - change this if your call center is elsewhere.
BUSINESS_TIMEZONE=

# Postgres - see server/lib/db.js. REQUIRED in production - without this,
# leads are stored in memory only and are lost on every restart/redeploy.
# On Render: the database's own page -> Connections -> Internal Database URL
# (use Internal, not External, when the API and the database are both on
# Render - it's free and faster than routing out to the public internet).
DATABASE_URL=

# Shared secret for the GET /api/leads admin/debug listing endpoint - send
# it back as `Authorization: Bearer <value>` to view captured leads outside
# the database directly. Generate any long random string; leave unset to
# disable the endpoint entirely (it refuses all requests with no key set,
# it does NOT fall back to open access).
ADMIN_API_KEY=
